+    query User($id: ID!) {
+        user(id: $id) {
+            assignedAttributes {
+                attribute {
+                    slug
+                }
+                ... on AssignedSingleChoiceAttribute {
+                    value {
+                        slug
+                    }
+                }
+            }
+        }
+    }
+"""
