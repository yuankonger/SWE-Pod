+        description = "Updates a customer type." + ADDED_IN_323
+        model = models.CustomerType
+        object_type = CustomerType
+        permissions = (CustomerTypePermissions.MANAGE_CUSTOMER_TYPES_AND_ATTRIBUTES,)
