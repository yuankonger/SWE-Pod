+ATTRIBUTE_FRAGMENT = """
+    fragment AttributeFields on Attribute {
+        slug
+        name
+        type
+        inputType
+        choices(first: 10) {
+            edges {
+                node {
+                    name
+                    slug
+                }
+            }
+        }
+        valueRequired
+        visibleInStorefront
+    }
