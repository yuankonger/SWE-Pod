+            ("test", "strip_outlet_1"), entry_b.entry_id
+        )
+        is None
+    )
+    assert (
+        device_registry.async_get_device_by_identifier(
+            ("test", "strip_outlet_1"), entry_b.entry_id
+        )
+        is main_device
+    )
+    assert (
+        device_registry.async_get_device_by_identifier(
+            ("test", "strip_outlet_1"), entry_a.entry_id
+        )
+        is None
+    )
