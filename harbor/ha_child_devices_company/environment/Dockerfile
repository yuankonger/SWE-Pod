# The agent's seat: every repository's toolchain, and a checkout of every repository under /work.
# Generated by tools/export_harbor_company.py. The same image runs the sidecars.
# The `core` toolchain (from mined/ha_core_child_devices/Dockerfile)
# Home Assistant Core at its August 2026 toolchain: Python 3.14.5 (`.python-version`), uv 0.12.2 (`requirements.txt`),
# the OS packages and the dependency set its CI installs for the full test run (requirements.txt,
# requirements_all.txt, requirements_test.txt, under homeassistant/package_constraints.txt). The feature's commits
# change none of them. No source: the repository is mounted and run from its own directory.
FROM python:3.14.5-bookworm@sha256:d1552003e0eb6e4a2c57fcc17c1b1f14fca6b00b1b709bb0e4eb82f21bce5c8c AS base-core
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bluez ffmpeg libturbojpeg0 libxml2-utils libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev \
        libavutil-dev libswresample-dev libswscale-dev libudev-dev libpcap-dev libyaml-dev cmake autoconf pkg-config \
    && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir uv==0.12.2
# Only the files the install reads (the requirements include each other and the constraints by these paths).
COPY work/core/.python-version work/core/requirements.txt work/core/requirements_all.txt work/core/requirements_test.txt work/core/requirements_test_pre_commit.txt /deps/
COPY work/core/homeassistant/package_constraints.txt /deps/homeassistant/
RUN cd /deps && uv venv /venv --python /usr/local/bin/python3.14 \
    && VIRTUAL_ENV=/venv uv pip install -r requirements.txt \
    && VIRTUAL_ENV=/venv uv pip install -r requirements_all.txt -r requirements_test.txt \
    && rm -rf /root/.cache
ENV PATH=/venv/bin:$PATH VIRTUAL_ENV=/venv PYTHONDONTWRITEBYTECODE=1
# The kernel's shell is a login shell, which resets PATH from /etc/profile: put the environment back on it there.
RUN printf 'export PATH=/venv/bin:$PATH VIRTUAL_ENV=/venv\n' > /etc/profile.d/venv.sh
# The `frontend` toolchain (from mined/ha_frontend_child_devices/Dockerfile)
# Home Assistant frontend at its August 2026 toolchain: Node 24.19.0 (`.nvmrc`), yarn 4.18.0 from the repository's own
# release (`.yarn/releases`), and the locked dependencies of the base commit with the project's yarn patches (the
# feature's commits change none of them). No source: the repository is mounted, and its `node_modules` links here.
FROM node:24.19.0-bookworm@sha256:4196d66a565c6f195728d9952f161f4adfe2ad753052a08b7ec7f1c5a6bda42b AS base-frontend
# Only the files the install reads: the manifest, the lock, yarn's settings, its release and the project's patches.
COPY work/frontend/package.json work/frontend/yarn.lock work/frontend/.yarnrc.yml /deps/
COPY work/frontend/.yarn /deps/.yarn
RUN cd /deps && node .yarn/releases/yarn-4.18.0.cjs install --immutable && rm -rf /root/.cache /root/.yarn /deps/.yarn/cache
# Without a network nothing may be installed or checked when a script runs.
ENV CI=true NODE_PATH=/deps/node_modules
FROM base-core
COPY --from=base-frontend /usr/local/bin/node /usr/local/bin/node
COPY --from=base-frontend /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN cd /usr/local/bin && ln -sf node nodejs && ln -sf ../lib/node_modules/npm/bin/npm-cli.js npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js npx \
    && if [ -d ../lib/node_modules/pnpm ]; then ln -sf ../lib/node_modules/pnpm/bin/pnpm.mjs pnpm; elif command -v corepack > /dev/null; then corepack enable pnpm; fi
COPY --from=base-frontend /deps /deps-base-frontend
RUN mkdir -p /deps && cp -an /deps-base-frontend/. /deps/ && rm -rf /deps-base-frontend
ENV CI=true pnpm_config_verify_deps_before_run=false NODE_PATH=/deps/node_modules
# Codex is put in here because its own installer fetches from hosts the seat cannot reach (see UNREACHABLE).
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep && rm -rf /var/lib/apt/lists/*     && npm install -g @openai/codex@0.169.0 && codex --version
RUN cd /deps && npx playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*
# the judge runs the work's code as this user, never as root (sidecars/judge.py)
RUN useradd -m -s /bin/bash scorer
COPY sidecars /opt/seedco
COPY work /work
RUN git config --global user.name SeedCo && git config --global user.email seedco@example.com \
    && git config --global init.defaultBranch main && git config --global --add safe.directory '*' \
    && for r in core frontend; do (cd /work/$r && git init -q && git add -A -f && git commit -qm "Where the work starts") || exit 1; done
WORKDIR /work
ENTRYPOINT ["/opt/seedco/seat.sh"]
CMD ["bash"]
