# Every container of the company but DynamoDB: the two repositories under /work with their toolchains, and the sidecars.
# Generated by tools/export_harbor_payments.py from the images company/payments/build.sh makes.
FROM seedco-payments-stripe:1 AS payments
FROM seedco-payments-core:1
COPY --from=payments /usr/local/bin/node /usr/local/bin/node
COPY --from=payments /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN cd /usr/local/bin && ln -sf node nodejs && ln -sf ../lib/node_modules/npm/bin/npm-cli.js npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js npx && ln -sf ../lib/node_modules/pnpm/bin/pnpm.cjs pnpm
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep && rm -rf /var/lib/apt/lists/*
RUN printf '#!/bin/bash\nservice postgresql start >/dev/null 2>&1\nsu postgres -c "psql -qc \\"CREATE ROLE saleor SUPERUSER LOGIN PASSWORD '"'"'saleor'"'"'\\" -c '"'"'CREATE DATABASE saleor OWNER saleor'"'"'" >/dev/null 2>&1\nexec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh
RUN printf 'export PATH=/venv/bin:$PATH\n' > /etc/profile.d/venv.sh
ENV CI=true NEXT_TELEMETRY_DISABLED=1 pnpm_config_verify_deps_before_run=false ALLOWED_HOSTS=*
RUN mkdir /work && mv /srv/core /work/core
COPY --from=payments /srv/apps /work/payments
COPY sidecars /opt/seedco
COPY notes/core.md /work/core/NOTES.md
COPY notes/payments.md /work/payments/NOTES.md
COPY faults/core.patch /tmp/fault-core.patch
RUN cd /work/core && git apply --whitespace=nowarn /tmp/fault-core.patch && rm /tmp/fault-core.patch
COPY faults/payments.patch /tmp/fault-payments.patch
RUN cd /work/payments && git apply --whitespace=nowarn /tmp/fault-payments.patch && rm /tmp/fault-payments.patch
RUN git config --global user.name SeedCo && git config --global user.email seedco@example.com \
    && git config --global init.defaultBranch main && git config --global --add safe.directory '*' \
    && for r in core payments; do (cd /work/$r && git init -q && git add -A && git commit -qm "Where the work starts") || exit 1; done
WORKDIR /work
ENTRYPOINT ["/opt/seedco/seat.sh"]
CMD ["bash"]
