# Every container of the company but the mail server and DynamoDB: the three repositories under /work with their
# toolchains, and the sidecars. Generated by tools/export_harbor_platform.py from the images company/platform/build.sh makes.
FROM seedco-platform-apps:1 AS apps
FROM seedco-platform-dashboard:1 AS dashboard
FROM seedco-platform-core:1
COPY --from=apps /usr/local/bin/node /usr/local/bin/node
COPY --from=apps /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN cd /usr/local/bin && ln -sf node nodejs && ln -sf ../lib/node_modules/npm/bin/npm-cli.js npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js npx && ln -sf ../lib/node_modules/pnpm/bin/pnpm.cjs pnpm
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep && rm -rf /var/lib/apt/lists/*
RUN printf '#!/bin/bash\nservice postgresql start >/dev/null 2>&1\nsu postgres -c "psql -qc \\"CREATE ROLE saleor SUPERUSER LOGIN PASSWORD '"'"'saleor'"'"'\\" -c '"'"'CREATE DATABASE saleor OWNER saleor'"'"'" >/dev/null 2>&1\nexec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh
RUN printf 'export PATH=/venv/bin:$PATH\n' > /etc/profile.d/venv.sh
ENV CI=true NEXT_TELEMETRY_DISABLED=1 pnpm_config_verify_deps_before_run=false ALLOWED_HOSTS=*
RUN mkdir /work && mv /srv/core /work/core
COPY --from=apps /srv/apps /work/apps
COPY --from=apps /root/.local/share/pnpm /root/.local/share/pnpm
COPY --from=dashboard /srv/dashboard /work/dashboard
# The back office's dependencies are a real directory inside its checkout: its development server only reads files
# under the checkout's parent. Its browser (Playwright's chromium) is here for whoever checks it as staff see it.
RUN rm -f /work/dashboard/node_modules
COPY --from=dashboard /srv/deps/node_modules /work/dashboard/node_modules
COPY --from=dashboard /ms-playwright /ms-playwright
ENV NODE_PATH=/work/dashboard/node_modules PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN cd /work/dashboard && rm -f node_modules/.modules.yaml.lock && npx playwright install-deps chromium && rm -rf /var/lib/apt/lists/*
COPY sidecars /opt/seedco
COPY notes/core.md /work/core/NOTES.md
COPY notes/apps.md /work/apps/NOTES.md
COPY notes/dashboard.md /work/dashboard/NOTES.md
RUN git config --global user.name SeedCo && git config --global user.email seedco@example.com \
    && git config --global init.defaultBranch main && git config --global --add safe.directory '*' \
    && for r in core dashboard apps; do (cd /work/$r && git init -q && git add -A && git commit -qm "Where the work starts") || exit 1; done
WORKDIR /work
ENTRYPOINT ["/opt/seedco/seat.sh"]
CMD ["bash"]
