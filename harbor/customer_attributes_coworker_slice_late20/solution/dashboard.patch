+            >
+              <FormattedMessage {...buttonMessages.cancel} />
+            </Button>
+          ) : null}
+          {showMenu ? (
+            <Dropdown>
+              <Dropdown.Trigger>
+                <Button
+                  variant="tertiary"
+                  type="button"
+                  data-test-id="customer-attributes-menu"
+                  icon={
+                    <EllipsisVertical
