+            disabled={disabled}
+            variant="primary"
+            data-test-id="create-customer-type"
+          >
+            <FormattedMessage
+              id="qC83EA"
+              defaultMessage="Create customer type"
+              description="button"
+            />
+          </Button>
+        </Box>
+      </TopNav>
+      <Box paddingX={6}>
+        <CustomerTypeList
+          {...listProps}
+          disabled={disabled}
+          search={{
+            placeholder: intl.formatMessage({
+              id: "MUjTkk",
