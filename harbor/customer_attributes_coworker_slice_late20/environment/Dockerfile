# The agent's seat: every repository's toolchain, and a checkout of every repository under /work.
# Generated by tools/export_harbor_company.py. The same image runs the sidecars.
# The `core` toolchain (from mined/saleor_customer_type_delete/Dockerfile)
# Saleor core at its August 2026 toolchain: Python 3.12, uv, a local PostgreSQL, the system libraries Saleor's own
# Dockerfile installs, and the locked dependencies of the base commit (the target's are identical). No source.
FROM python:3.12-bookworm@sha256:4209fae09a3e20afd863e528bfddc235da5fd5977983e1996cd54cc9a72e6267 AS base-core
RUN apt-get update && apt-get install -y --no-install-recommends postgresql gettext libmagic1 libcairo2 libgdk-pixbuf2.0-0 \
    liblcms2-2 libopenjp2-7 libpango-1.0-0 libpangocairo-1.0-0 libtiff6 libwebp7 libxml2 libpq5 shared-mime-info mime-support \
    && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir uv
COPY work/core/pyproject.toml work/core/uv.lock /deps/
RUN cd /deps && UV_PROJECT_ENVIRONMENT=/venv uv sync --frozen --all-groups --no-install-project && rm -rf /root/.cache
ENV PATH=/venv/bin:$PATH DATABASE_URL=postgres://saleor:saleor@127.0.0.1:5432/saleor SECRET_KEY=not-a-secret PYTHONDONTWRITEBYTECODE=1
# The kernel's shell is a login shell, which resets PATH from /etc/profile: put the environment back on it there.
RUN printf 'export PATH=/venv/bin:$PATH\n' > /etc/profile.d/venv.sh
# PostgreSQL runs inside the container, so tests need no network.
RUN printf '#!/bin/bash\nservice postgresql start >/dev/null 2>&1\nsu postgres -c "psql -qc \\"CREATE ROLE saleor SUPERUSER LOGIN PASSWORD '"'"'saleor'"'"'\\" -c '"'"'CREATE DATABASE saleor OWNER saleor'"'"'" >/dev/null 2>&1\nexec "$@"\n' > /entrypoint.sh && chmod +x /entrypoint.sh
# The `dashboard` toolchain (from mined/dashboard_customer_types/Dockerfile)
# Saleor Dashboard at its August 2026 toolchain: Node 24, pnpm 11 and the locked dependencies of the base commit
# (the feature changes none of them). No source: the repository is mounted, and its `node_modules` links here.
FROM node:24-bookworm@sha256:9d266751ca3d7fdbe651c878ffd5ad0a42fed49a18c283509267c97f025b7496 AS base-dashboard
RUN npm install -g pnpm@11.13.1
COPY work/dashboard/package.json work/dashboard/pnpm-lock.yaml work/dashboard/pnpm-workspace.yaml /deps/
RUN cd /deps && pnpm install --frozen-lockfile --ignore-scripts && rm -rf /root/.local/share/pnpm/store /root/.cache
# Without a network pnpm must not try to check or reinstall dependencies before every `pnpm run`.
ENV CI=true pnpm_config_verify_deps_before_run=false NODE_PATH=/deps/node_modules
FROM base-core
COPY --from=base-dashboard /usr/local/bin/node /usr/local/bin/node
COPY --from=base-dashboard /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN cd /usr/local/bin && ln -sf node nodejs && ln -sf ../lib/node_modules/npm/bin/npm-cli.js npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js npx \
    && if [ -d ../lib/node_modules/pnpm ]; then ln -sf ../lib/node_modules/pnpm/bin/pnpm.mjs pnpm; elif command -v corepack > /dev/null; then corepack enable pnpm; fi
RUN --mount=type=bind,from=base-dashboard,source=/deps,target=/mnt/toolchain mkdir -p /deps && cp -an /mnt/toolchain/. /deps/
ENV CI=true pnpm_config_verify_deps_before_run=false NODE_PATH=/deps/node_modules ALLOWED_HOSTS=*
# Codex is put in here because its own installer fetches from hosts the seat cannot reach (see UNREACHABLE).
RUN apt-get update && apt-get install -y --no-install-recommends ripgrep && rm -rf /var/lib/apt/lists/*     && npm install -g @openai/codex@0.169.0 && codex --version
# the judge runs the work's code as this user, never as root (sidecars/judge.py)
RUN useradd -m -s /bin/bash scorer
COPY sidecars /opt/seedco
COPY work /work
RUN git config --global user.name SeedCo && git config --global user.email seedco@example.com \
    && git config --global init.defaultBranch main && git config --global --add safe.directory '*' \
    && for r in core dashboard; do (cd /work/$r && git init -q && git add -A -f && git commit -qm "Where the work starts") || exit 1; done
WORKDIR /work
ENTRYPOINT ["/opt/seedco/seat.sh"]
CMD ["bash"]
