#!/usr/bin/env bash
# Orders (Java). Same task names in every service: ./run test | ./run serve
set -euo pipefail
cd "$(dirname "$0")"
JARS=${SEEDCO_JARS:-/opt/jars}
OUT=${SEEDCO_BUILD_DIR:-/tmp/seedco-build/orders}
build() {
  mkdir -p "$OUT/main"
  javac -nowarn -cp "$JARS/*" -d "$OUT/main" $(find src -name '*.java')
}
case "${1:-}" in
  test)
    build
    mkdir -p "$OUT/test"
    javac -nowarn -cp "$JARS/*:$OUT/main" -d "$OUT/test" $(find test -name '*.java')
    java -jar "$JARS"/junit-platform-console-standalone-*.jar execute --class-path "$OUT/main:$OUT/test:$JARS/*" \
      --scan-class-path "$OUT/test" --disable-banner --details=summary --fail-if-no-tests
    ;;
  serve)
    build
    exec java -cp "$OUT/main:$JARS/*" seedco.orders.Main
    ;;
  *) echo "usage: ./run test|serve" >&2; exit 2 ;;
esac
