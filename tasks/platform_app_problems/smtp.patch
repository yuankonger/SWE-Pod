diff --git a/apps/smtp/src/modules/smtp/configuration/smtp-configuration.router.problems.test.ts b/apps/smtp/src/modules/smtp/configuration/smtp-configuration.router.problems.test.ts
new file mode 100644
index 0000000..806e9e6
--- /dev/null
+++ b/apps/smtp/src/modules/smtp/configuration/smtp-configuration.router.problems.test.ts
@@ -0,0 +1,95 @@
+import { errAsync, okAsync } from "neverthrow";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import { saleorApp } from "../../../saleor-app";
+import { SmtpProblemReporter } from "../../app-problems/smtp-problem-reporter";
+import { smtpConfigurationRouter } from "./smtp-configuration.router";
+import { SmtpConfigurationService } from "./smtp-configuration.service";
+import { smtpDefaultEmptyConfigurations } from "./smtp-default-empty-configurations";
+
+vi.mock("../../webhook-management/sync-webhook-status", () => ({
+  syncWebhookStatus: vi.fn(),
+}));
+
+const mockSaleorApiUrl = "https://test.saleor.io/graphql/";
+
+const createCaller = () =>
+  smtpConfigurationRouter.createCaller({
+    saleorApiUrl: mockSaleorApiUrl,
+    token: "mock-token",
+    ssr: true,
+    appId: "app:id",
+    baseUrl: "",
+  });
+
+const smtpInput = {
+  id: "config-1",
+  smtpHost: "smtp.example.com",
+  smtpPort: "587",
+  smtpUser: "user",
+  smtpPassword: "password",
+  encryption: "TLS" as const,
+};
+
+describe("smtpConfigurationRouter - app problems", () => {
+  const configuration = { ...smtpDefaultEmptyConfigurations.configuration(), id: "config-1" };
+  const clearProblemsForConfig = vi.spyOn(SmtpProblemReporter.prototype, "clearProblemsForConfig");
+  const updateConfiguration = vi.spyOn(SmtpConfigurationService.prototype, "updateConfiguration");
+  const deleteConfiguration = vi.spyOn(SmtpConfigurationService.prototype, "deleteConfiguration");
+
+  beforeEach(() => {
+    vi.spyOn(saleorApp.apl, "get").mockResolvedValue({
+      saleorApiUrl: mockSaleorApiUrl,
+      token: "mock-token",
+      appId: "mock-app-id",
+    });
+
+    clearProblemsForConfig.mockReset().mockResolvedValue();
+    updateConfiguration.mockReset().mockReturnValue(okAsync(configuration));
+    deleteConfiguration.mockReset().mockReturnValue(okAsync(undefined));
+  });
+
+  it("updateSmtp dismisses all problems of the updated configuration", async () => {
+    await createCaller().updateSmtp(smtpInput);
+
+    expect(clearProblemsForConfig).toHaveBeenCalledOnce();
+    expect(clearProblemsForConfig).toHaveBeenCalledWith("config-1");
+  });
+
+  it("updateSmtp does not dismiss problems if configuration was not saved", async () => {
+    updateConfiguration.mockReturnValue(
+      errAsync(new SmtpConfigurationService.ConfigNotFoundError("Configuration not found")),
+    );
+
+    await expect(createCaller().updateSmtp(smtpInput)).rejects.toThrow();
+
+    expect(clearProblemsForConfig).not.toHaveBeenCalled();
+  });
+
+  it("updateSender dismisses only rejected sender problem", async () => {
+    await createCaller().updateSender({
+      id: "config-1",
+      senderEmail: "shop@example.com",
+      senderName: "Shop",
+    });
+
+    expect(clearProblemsForConfig).toHaveBeenCalledOnce();
+    expect(clearProblemsForConfig).toHaveBeenCalledWith("config-1", ["senderRejected"]);
+  });
+
+  it("deleteConfiguration dismisses all problems of the deleted configuration", async () => {
+    await createCaller().deleteConfiguration({ id: "config-1" });
+
+    expect(clearProblemsForConfig).toHaveBeenCalledOnce();
+    expect(clearProblemsForConfig).toHaveBeenCalledWith("config-1");
+  });
+
+  it.each(["updateBasicInformation", "updateBranding"] as const)(
+    "%s keeps problems, because it does not change what they are about",
+    async (procedure) => {
+      await createCaller()[procedure]({ id: "config-1", name: "New name", active: true });
+
+      expect(clearProblemsForConfig).not.toHaveBeenCalled();
+    },
+  );
+});
