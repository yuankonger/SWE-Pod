@@ -0,0 +1,191 @@
+import { type Client } from "urql";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import { SmtpEmailSender } from "../smtp/services/smtp-email-sender";
+import { classifySmtpError, PROBLEM_KEYS, SmtpProblemReporter } from "./smtp-problem-reporter";
+
+const config = {
+  id: "config-1",
+  name: "Main mailbox",
+  smtpHost: "smtp.example.com",
+  smtpPort: "587",
+  senderEmail: "shop@example.com",
+};
+
+/**
+ * Errors in the shape Nodemailer rejects with
+ */
+const smtpError = (props: { code: string; command?: string; responseCode?: number }) =>
+  Object.assign(new Error("SMTP error"), props);
+
+const connectionRefused = smtpError({ code: "ESOCKET", command: "CONN" });
+const invalidLogin = smtpError({ code: "EAUTH", command: "AUTH PLAIN", responseCode: 535 });
+const senderRejected = smtpError({ code: "EENVELOPE", command: "MAIL FROM", responseCode: 550 });
+
+describe("classifySmtpError", () => {
+  it.each(["ECONNECTION", "ESOCKET", "ETIMEDOUT", "EDNS", "ETLS"])(
+    "treats %s as connection failure",
+    (code) => {
+      expect(classifySmtpError(smtpError({ code, command: "CONN" }))).toBe("connectionFailure");
+    },
+  );
+
+  it("treats sender timeout as connection failure", () => {
+    expect(
+      classifySmtpError(new SmtpEmailSender.SmtpEmailSenderTimeoutError("Sending email timeout")),
+    ).toBe("connectionFailure");
+  });
+
+  it("treats rejected login as auth failure", () => {
+    expect(classifySmtpError(invalidLogin)).toBe("authFailure");
+  });
+
+  it("treats permanently rejected MAIL FROM as rejected sender", () => {
+    expect(classifySmtpError(senderRejected)).toBe("senderRejected");
+  });
+
+  it.each([
+    ["temporarily rejected sender", { code: "EENVELOPE", command: "MAIL FROM", responseCode: 451 }],
+    ["rejected recipient", { code: "EENVELOPE", command: "RCPT TO", responseCode: 550 }],
+    ["rejected message", { code: "EMESSAGE", command: "DATA", responseCode: 554 }],
+  ])("ignores %s", (_name, props) => {
+    expect(classifySmtpError(smtpError(props))).toBeNull();
+  });
+
+  it.each([[new Error("Unknown encryption type")], ["string"], [null], [undefined]])(
+    "ignores errors that did not come from SMTP server: %s",
+    (error) => {
+      expect(classifySmtpError(error)).toBeNull();
+    },
+  );
+});
+
+describe("SmtpProblemReporter", () => {
+  const mutation = vi.fn();
+  const getSaleorVersion = vi.fn<() => Promise<string>>();
+  const client = { mutation } as unknown as Client;
+
+  const mockMutationResult = (result: { data?: unknown; error?: Error }) =>
+    mutation.mockReturnValue({ toPromise: async () => result });
+
+  const createReporter = () => new SmtpProblemReporter({ client, getSaleorVersion });
+
+  beforeEach(() => {
+    vi.resetAllMocks();
+    getSaleorVersion.mockResolvedValue("3.22.36");
+    mockMutationResult({ data: { appProblemCreate: { errors: [] } } });
+  });
+
+  describe("reportSendFailure", () => {
+    it.each([
+      { error: connectionRefused, key: "smtp-connection-failure:config-1", criticalThreshold: 3 },
+      { error: invalidLogin, key: "smtp-auth-failure:config-1", criticalThreshold: 1 },
+      { error: senderRejected, key: "smtp-sender-rejected:config-1", criticalThreshold: 1 },
+    ])("reports $key, naming the configuration", async ({ error, key, criticalThreshold }) => {
+      await createReporter().reportSendFailure(error, config);
+
+      expect(mutation).toHaveBeenCalledOnce();
+      expect(mutation.mock.calls[0][1]).toStrictEqual({
+        input: {
+          key,
+          criticalThreshold,
+          message: expect.stringContaining('configuration "Main mailbox"'),
+        },
+      });
+    });
+
+    it("names the server and the sender in the message, but never the credentials", async () => {
+      await createReporter().reportSendFailure(senderRejected, {
+        ...config,
+        ...{ smtpUser: "user", smtpPassword: "secret-password" },
+      });
+
+      const { message } = mutation.mock.calls[0][1].input;
+
+      expect(message).toContain("smtp.example.com:587");
+      expect(message).toContain('"shop@example.com"');
+      expect(message).not.toContain("secret-password");
+    });
+
+    it("does not report errors specific to a single message", async () => {
+      await createReporter().reportSendFailure(
+        smtpError({ code: "EENVELOPE", command: "RCPT TO", responseCode: 550 }),
+        config,
+      );
+
+      expect(getSaleorVersion).not.toHaveBeenCalled();
+      expect(mutation).not.toHaveBeenCalled();
+    });
+
+    it.each(["3.22.35", "3.21.4", "3.20.0"])(
+      "does not call the API in Saleor %s, which does not have it",
+      async (version) => {
+        getSaleorVersion.mockResolvedValue(version);
+
+        await createReporter().reportSendFailure(invalidLogin, config);
+
+        expect(mutation).not.toHaveBeenCalled();
+      },
+    );
+
+    it("does not call the API and does not throw if Saleor version can not be resolved", async () => {
+      getSaleorVersion.mockRejectedValue(new Error("Can't fetch Saleor version"));
+
+      await expect(createReporter().reportSendFailure(invalidLogin, config)).resolves.not.toThrow();
+      expect(mutation).not.toHaveBeenCalled();
+    });
+
+    it("does not throw when Saleor rejects the mutation", async () => {
+      mockMutationResult({ error: new Error('Cannot query field "appProblemCreate"') });
+
+      await expect(createReporter().reportSendFailure(invalidLogin, config)).resolves.not.toThrow();
+    });
+
+    it("does not throw when the client throws", async () => {
+      mutation.mockImplementation(() => {
+        throw new Error("Network error");
+      });
+
+      await expect(createReporter().reportSendFailure(invalidLogin, config)).resolves.not.toThrow();
+    });
+  });
+
+  describe("clearProblemsForConfig", () => {
+    beforeEach(() => {
+      mockMutationResult({ data: { appProblemDismiss: { errors: [] } } });
+    });
+
+    it("dismisses all problems of the configuration by key", async () => {
+      await createReporter().clearProblemsForConfig("config-1");
+
+      expect(mutation).toHaveBeenCalledOnce();
+      expect(mutation.mock.calls[0][1]).toStrictEqual({
+        keys: [
+          PROBLEM_KEYS.connectionFailure("config-1"),
+          PROBLEM_KEYS.authFailure("config-1"),
+          PROBLEM_KEYS.senderRejected("config-1"),
+        ],
+      });
+    });
+
+    it("dismisses only requested kinds", async () => {
+      await createReporter().clearProblemsForConfig("config-1", ["senderRejected"]);
+
+      expect(mutation.mock.calls[0][1]).toStrictEqual({ keys: ["smtp-sender-rejected:config-1"] });
+    });
+
+    it("does not call the API in Saleor which does not have it", async () => {
+      getSaleorVersion.mockResolvedValue("3.21.0");
+
+      await createReporter().clearProblemsForConfig("config-1");
+
+      expect(mutation).not.toHaveBeenCalled();
+    });
+
+    it("does not throw when Saleor rejects the mutation", async () => {
+      mockMutationResult({ error: new Error("Network error") });
+
+      await expect(createReporter().clearProblemsForConfig("config-1")).resolves.not.toThrow();
+    });
+  });
+});
diff --git a/apps/smtp/src/modules/app-problems/smtp-problem-reporter.ts b/apps/smtp/src/modules/app-problems/smtp-problem-reporter.ts
