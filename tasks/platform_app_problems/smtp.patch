+++ b/apps/smtp/src/modules/app-problems/smtp-problem-reporter.ts
@@ -0,0 +1,172 @@
+import { AppProblemsReporter } from "@saleor/app-problems";
+import { type Client } from "urql";
+
+import { createLogger } from "../../logger";
+import { type SmtpConfiguration } from "../smtp/configuration/smtp-config-schema";
+import { SmtpEmailSender } from "../smtp/services/smtp-email-sender";
+
+const logger = createLogger("SmtpProblemReporter");
+
+export const PROBLEM_KEYS = {
+  connectionFailure: (configId: string) => `smtp-connection-failure:${configId}`,
+  authFailure: (configId: string) => `smtp-auth-failure:${configId}`,
+  senderRejected: (configId: string) => `smtp-sender-rejected:${configId}`,
+} as const;
+
+export type SmtpProblemKind = keyof typeof PROBLEM_KEYS;
+
+type ProblemConfig = Pick<
+  SmtpConfiguration,
+  "id" | "name" | "smtpHost" | "smtpPort" | "senderEmail"
+>;
+
+/**
+ * Nodemailer error codes raised before the SMTP conversation can start: the server
+ * can not be resolved, refuses the connection, does not answer or fails the TLS handshake.
+ */
+const CONNECTION_ERROR_CODES = ["ECONNECTION", "ESOCKET", "ETIMEDOUT", "EDNS", "ETLS"];
+
+/**
+ * Maps an error thrown while sending to a problem staff has to act on.
+ * Returns null for everything that is specific to a single message (rejected recipient,
+ * message content, unknown errors) - these should not be raised as app problems.
+ */
+export const classifySmtpError = (error: unknown): SmtpProblemKind | null => {
+  if (error instanceof SmtpEmailSender.SmtpEmailSenderTimeoutError) {
+    return "connectionFailure";
+  }
+
+  if (typeof error !== "object" || error === null) {
+    return null;
+  }
+
+  const { code, command, responseCode } = error as {
+    code?: unknown;
+    command?: unknown;
+    responseCode?: unknown;
+  };
+
+  if (code === "EAUTH") {
+    return "authFailure";
+  }
+
+  if (typeof code === "string" && CONNECTION_ERROR_CODES.includes(code)) {
+    return "connectionFailure";
+  }
+
+  // Permanent (5xx) answer to MAIL FROM. 4xx is temporary (e.g. greylisting) and Saleor retries the webhook.
+  if (
+    code === "EENVELOPE" &&
+    command === "MAIL FROM" &&
+    typeof responseCode === "number" &&
+    responseCode >= 500
+  ) {
+    return "senderRejected";
+  }
+
+  return null;
+};
+
+const problems: Record<
+  SmtpProblemKind,
+  { criticalThreshold: number; message: (config: ProblemConfig) => string }
+> = {
+  connectionFailure: {
+    // A single timeout can be a network blip. Three within the aggregation period mean the server is down or misconfigured.
+    criticalThreshold: 3,
+    message: (config) =>
+      `SMTP server ${config.smtpHost}:${config.smtpPort} of configuration "${config.name}" can not be reached (connection refused or timed out). Emails using this configuration are not being sent. Please verify the host, port and encryption of the configuration and that the server is running.`,
+  },
+  authFailure: {
+    criticalThreshold: 1,
+    message: (config) =>
+      `SMTP server ${config.smtpHost}:${config.smtpPort} rejected the credentials of configuration "${config.name}". Emails using this configuration are not being sent. Please update the SMTP user and password.`,
+  },
+  senderRejected: {
+    criticalThreshold: 1,
+    message: (config) =>
+      `SMTP server ${config.smtpHost}:${config.smtpPort} rejected the sender address "${config.senderEmail}" of configuration "${config.name}". Emails using this configuration are not being sent. Please use a sender address the server is allowed to send from.`,
+  },
+};
+
+export interface ISmtpProblemReporter {
+  reportSendFailure(error: unknown, config: ProblemConfig): Promise<void>;
+}
+
+/**
+ * Reports SMTP delivery problems to Saleor (App Problems API), so staff can see them in the Dashboard.
+ * Methods never throw - failing to report must not change how the webhook or the configuration update ends.
+ */
+export class SmtpProblemReporter implements ISmtpProblemReporter {
+  private reporter: AppProblemsReporter;
+  private getSaleorVersion: () => Promise<string>;
+
+  constructor(args: { client: Client; getSaleorVersion: () => Promise<string> }) {
+    this.reporter = new AppProblemsReporter(args.client);
+    this.getSaleorVersion = args.getSaleorVersion;
+  }
+
+  /**
+   * SMTP webhook payloads do not include Saleor version, so it is fetched (only when there is something to report).
+   */
+  private async isApiAvailable(): Promise<boolean> {
+    try {
+      return AppProblemsReporter.isApiCompatible(await this.getSaleorVersion());
+    } catch (e) {
+      logger.warn("Can not resolve Saleor version, skipping App Problems API", { error: e });
+
+      return false;
+    }
+  }
+
+  async reportSendFailure(error: unknown, config: ProblemConfig): Promise<void> {
+    const kind = classifySmtpError(error);
+
+    if (!kind) {
+      return;
+    }
+
+    try {
+      if (!(await this.isApiAvailable())) {
+        return;
+      }
+
+      const result = await this.reporter.reportProblem({
+        key: PROBLEM_KEYS[kind](config.id),
+        criticalThreshold: problems[kind].criticalThreshold,
+        message: problems[kind].message(config),
+      });
+
+      if (result.isErr()) {
+        logger.warn("Failed to report SMTP problem", { error: result.error, kind });
+      }
+    } catch (e) {
+      logger.warn("Failed to report SMTP problem", { error: e, kind });
+    }
+  }
+
+  /**
+   * Dismisses problems of the configuration. Should be called when staff changes the settings
+   * the problems refer to - if they are still wrong, the next failed email will report again.
+   */
+  async clearProblemsForConfig(
+    configId: string,
+    kinds: SmtpProblemKind[] = ["connectionFailure", "authFailure", "senderRejected"],
+  ): Promise<void> {
+    try {
+      if (!(await this.isApiAvailable())) {
+        return;
+      }
+
+      const result = await this.reporter.clearProblems(
+        kinds.map((kind) => PROBLEM_KEYS[kind](configId)),
+      );
+
+      if (result.isErr()) {
+        logger.warn("Failed to clear SMTP problems", { error: result.error, configId });
+      }
+    } catch (e) {
+      logger.warn("Failed to clear SMTP problems", { error: e, configId });
+    }
+  }
+}
