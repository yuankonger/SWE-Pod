+    info: vi.fn(),
+    debug: vi.fn(),
+  }),
+}));
+
+describe("TransactionInitializeSessionUseCase - problem reporting", () => {
+  const stripePaymentIntentsApiFactory = {
+    create: () => mockedStripePaymentIntentsApi,
