{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice.paid",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "invoice.paid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "invoice"
      ],
      "properties": {
        "invoice": {
          "type": "object",
          "required": [
            "invoice_id",
            "order_id",
            "customer_id",
            "email",
            "reason",
            "lines",
            "subtotal",
            "tax",
            "total",
            "status",
            "issued_at"
          ],
          "properties": {
            "invoice_id": {
              "type": "string"
            },
            "order_id": {
              "type": "string"
            },
            "subscription_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "customer_id": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "enum": [
                "order",
                "renewal",
                "plan_change"
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "sku",
                  "name",
                  "qty",
                  "unit_price",
                  "amount"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "RECURRING",
                      "FIXED",
                      "PRORATION",
                      "CREDIT"
                    ]
                  },
                  "sku": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "qty": {
                    "type": "integer"
                  },
                  "unit_price": {
                    "type": "object",
                    "required": [
                      "currency",
                      "minor"
                    ],
                    "properties": {
                      "currency": {
                        "const": "USD"
                      },
                      "minor": {
                        "type": "integer"
                      }
                    }
                  },
                  "amount": {
                    "type": "object",
                    "required": [
                      "currency",
                      "minor"
                    ],
                    "properties": {
                      "currency": {
                        "const": "USD"
                      },
                      "minor": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            },
            "subtotal": {
              "type": "object",
              "required": [
                "currency",
                "minor"
              ],
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "minor": {
                  "type": "integer"
                }
              }
            },
            "tax": {
              "type": "object",
              "required": [
                "currency",
                "minor"
              ],
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "minor": {
                  "type": "integer"
                }
              }
            },
            "total": {
              "type": "object",
              "required": [
                "currency",
                "minor"
              ],
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "minor": {
                  "type": "integer"
                }
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "paid",
                "refunded"
              ]
            },
            "issued_at": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
