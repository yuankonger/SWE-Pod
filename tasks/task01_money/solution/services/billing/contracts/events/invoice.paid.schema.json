{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice.paid",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "invoice.paid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "invoice"
      ],
      "properties": {
        "invoice": {
          "type": "object",
          "required": [
            "invoice_id",
            "order_id",
            "customer_id",
            "email",
            "lines",
            "subtotal",
            "tax",
            "total",
            "status",
            "issued_at"
          ],
          "properties": {
            "invoice_id": {
              "type": "string"
            },
            "order_id": {
              "type": "string"
            },
            "customer_id": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sku",
                  "name",
                  "qty",
                  "unit_price",
                  "amount"
                ],
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "qty": {
                    "type": "integer"
                  },
                  "unit_price": {"type": "object", "required": ["currency", "minor"], "properties": {"currency": {"const": "USD"}, "minor": {"type": "integer"}}},
                  "amount": {"type": "object", "required": ["currency", "minor"], "properties": {"currency": {"const": "USD"}, "minor": {"type": "integer"}}}
                }
              }
            },
            "subtotal": {"type": "object", "required": ["currency", "minor"], "properties": {"currency": {"const": "USD"}, "minor": {"type": "integer"}}},
            "tax": {"type": "object", "required": ["currency", "minor"], "properties": {"currency": {"const": "USD"}, "minor": {"type": "integer"}}},
            "total": {"type": "object", "required": ["currency", "minor"], "properties": {"currency": {"const": "USD"}, "minor": {"type": "integer"}}},
            "status": {
              "type": "string",
              "enum": [
                "paid"
              ]
            },
            "issued_at": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
