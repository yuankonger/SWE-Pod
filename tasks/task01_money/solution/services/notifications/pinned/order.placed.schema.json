{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order.placed",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "const": "order.placed"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "object",
          "required": [
            "order_id",
            "customer_id",
            "email",
            "postal_code",
            "status",
            "lines",
            "subtotal",
            "tax",
            "total"
          ],
          "properties": {
            "order_id": {
              "type": "string"
            },
            "customer_id": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "postal_code": {
              "type": "integer"
            },
            "status": {
              "type": "string",
              "enum": [
                "placed",
                "paid",
                "payment_failed",
                "shipped",
                "delivered",
                "cancelled"
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sku",
                  "name",
                  "qty",
                  "unit_price"
                ],
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "qty": {
                    "type": "integer"
                  },
                  "unit_price": {
                    "type": "object",
                    "required": [
                      "currency",
                      "minor"
                    ],
                    "properties": {
                      "currency": {
                        "const": "USD"
                      },
                      "minor": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            },
            "subtotal": {
              "type": "object",
              "required": [
                "currency",
                "minor"
              ],
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "minor": {
                  "type": "integer"
                }
              }
            },
            "tax": {
              "type": "object",
              "required": [
                "currency",
                "minor"
              ],
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "minor": {
                  "type": "integer"
                }
              }
            },
            "total": {
              "type": "object",
              "required": [
                "currency",
                "minor"
              ],
              "properties": {
                "currency": {
                  "const": "USD"
                },
                "minor": {
                  "type": "integer"
                }
              }
            },
            "payment_id": {
              "type": "string"
            },
            "payment_method": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            },
            "shipped_at": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
